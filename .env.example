# Copy to .env and edit. Real environment variables win over this file, so a
# stale .env cannot override what your platform sets.

# --- required ---------------------------------------------------------------
# The bearer token for the web UI and the MCP endpoint. Anyone holding it can
# read and send on your WhatsApp account — treat it as a password.
# Generate one with:  python -m wa_mcp --token=generate
WA_AUTH_TOKEN=
# MCP_AUTH_TOKEN is accepted as an alias, for hosts that already set that name.

# --- where it listens -------------------------------------------------------
WA_HOST=127.0.0.1
WA_PORT=8100

# The address clients reach it on. Required for OAuth, since the redirect and
# the metadata document are built from it. Behind a tunnel or proxy this is the
# public URL, not the local one.
PUBLIC_BASE_URL=

# --- storage ----------------------------------------------------------------
# Unset uses SQLite in the data directory, which needs no server and is the
# right choice for one number. Postgres also stores the WhatsApp session;
# Mongo cannot, so the session stays a local file even then.
#   postgresql://user:pass@host/db
#   mongodb://host/db
#   sqlite:////absolute/path/app.db
WA_DATABASE_URL=
WA_DATA_DIR=

# Only read on the Postgres path. "disable" is right for a local socket;
# a managed database will want "require".
WA_SESSION_SSLMODE=disable

# --- pairing ----------------------------------------------------------------
# How much history WhatsApp sends when you first link. These apply once, at
# pair time, and cannot be changed later without unlinking.
WA_HISTORY_DAYS=365
WA_HISTORY_SIZE_MB=500

# How the linked device presents itself, shown in WhatsApp > Linked Devices.
WA_DEVICE_OS=Chrome
WA_DEVICE_PLATFORM=CHROME

# --- behaviour --------------------------------------------------------------
# OAuth lets an MCP client authenticate by scanning the QR instead of pasting
# the token. Off falls back to the token in the URL.
WA_OAUTH=1

# Keeps the raw protobuf of every message. Needed only to re-download media
# that was never fetched; costs roughly a kilobyte per message.
WA_STORE_RAW_PROTO=0

LOG_LEVEL=INFO
